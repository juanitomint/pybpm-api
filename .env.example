# ============================================================
# PyBPM — Docker & Local Development Configuration
# Copy this to .env before running docker compose or flask run
# ============================================================

# --- PostgreSQL Database (replaces MongoDB in legacy dna2bpm) ---
DB_USER=pybpm_user
DB_PASSWORD=changeme-in-production
DB_NAME=pybpm_db
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}

# --- Flask Application ---
FLASK_CONFIG=development
APP_PORT=5000

# --- Security & JWT ---
SECRET_KEY=dev-secret-key-change-me-please-use-a-real-secret-in-production
JWT_EXPIRATION_HOURS=24

# --- RBAC Configuration ---
ADMIN_GROUP_ID=1

# --- Feature Flags ---
AUTODISCOVER_PATHS=false

# --- Logging & Debugging ---
LOG_LEVEL=INFO
SQL_DEBUG=true
